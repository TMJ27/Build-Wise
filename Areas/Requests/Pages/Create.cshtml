@page
@model BuildWise.Web.Areas.Requests.Pages.CreateModel
@{
    ViewData["Title"] = "New request";
    ViewData["PageTitle"] = ViewData["Title"];
    ViewData["PageSubTitle"] = "Choose the customer and describe the work required.";
    ViewData["Breadcrumbs"] = new BreadcrumbItem[] { new("Requests", Url.Page("/Index", new { area = "Requests" })) };
}

<div class="requests-page">
    <form method="post" class="form-stack">
        <div asp-validation-summary="All" class="configuration-errors" role="alert"></div>
        <section class="panel configuration-section form-panel">
            <h2>Customer and site</h2>
            <div class="form-fields">
                <div class="field form-wide">
                    <label asp-for="Input.ClientId">Customer <span>*</span></label>
                    <select class="form-control" asp-for="Input.ClientId" asp-items="Model.Customers" required><option value="">Choose a customer</option></select>
                    <span asp-validation-for="Input.ClientId"></span>
                    @if (Model.Customers.Count == 0)
                    {
                        <p>Add an active customer before creating a request.</p>
                        <a class="record-link" asp-area="Customers" asp-page="/Upsert" asp-route-id="">Add customer</a>
                    }
                </div>
                <div class="field form-wide">
                    <label asp-for="Input.SiteAddress">Site address <span>*</span></label>
                    <input class="form-control" asp-for="Input.SiteAddress" required maxlength="50" autocomplete="street-address" />
                    <span asp-validation-for="Input.SiteAddress"></span>
                </div>
                <div class="field form-wide">
                    <label asp-for="Input.PropertyType">Property type</label>
                    <input class="form-control" asp-for="Input.PropertyType" maxlength="50" placeholder="For example, existing house" />
                    <span asp-validation-for="Input.PropertyType"></span>
                </div>
            </div>
        </section>
        <section class="panel configuration-section form-panel">
            <h2>Requested work</h2>
            <div class="form-fields">
                <div class="field form-wide">
                    <label asp-for="Input.Title">Title <span>*</span></label>
                    <input class="form-control" asp-for="Input.Title" required maxlength="50" placeholder="For example, kitchen renovation" />
                    <span asp-validation-for="Input.Title"></span>
                </div>
                <div class="field form-wide">
                    <label asp-for="Input.ReferenceNumber">Reference</label>
                    <input class="form-control" asp-for="Input.ReferenceNumber" maxlength="50" aria-describedby="reference-help" />
                    <small id="reference-help">Leave blank to generate a request reference.</small>
                    <span asp-validation-for="Input.ReferenceNumber"></span>
                </div>
                <div class="field form-wide">
                    <label asp-for="Input.Description">Customer's description <span>*</span></label>
                    <textarea class="form-control" asp-for="Input.Description" required maxlength="3000" rows="4" placeholder="Describe the work, location and any known requirements."></textarea>
                    <span asp-validation-for="Input.Description"></span>
                </div>
            </div>
            <p>Prepare the individual scope items after saving this request.</p>
        </section>
        <div class="form-actions"><button class="btn primary" type="submit"><i class="fa-solid fa-plus" aria-hidden="true"></i><span>Create request</span></button></div>
    </form>
</div>
