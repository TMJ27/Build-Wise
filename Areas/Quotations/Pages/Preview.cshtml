@page "{id:int}"
@model BuildWise.Web.Areas.Quotations.Pages.PreviewModel
@{
    ViewData["Title"] = $"Preview · {Model.Entry.Number}";
    ViewData["AccountName"] = "Tawanda M.";
    ViewData["AccountRole"] = "Business owner";

    ViewData["PageTitle"] = "One last look before you share.";
    ViewData["PageHeaderClass"] = "quotation-preview-toolbar";
    ViewData["Breadcrumbs"] = new BreadcrumbItem[]
    {
        new("Quotations", Url.Page("/Index", new { area = "Quotations" }))
    };
}

@section actionbar {
    <button class="btn primary" type="button" id="print-quotation">
        @await Html.PartialAsync("_WorkspaceIcon", "file")
        <span>Print / Save PDF</span>
    </button>
    <a class="btn" asp-page="Details" asp-route-id="@Model.Entry.Quotation.Id">← Back to quotation</a>
}

<div class="requests-page quotations-page">

    @if (Model.Entry.CompanySnapshot is null)
    {
        <div class="request-validation" role="alert">This quotation has no saved company details. Save a draft with the configured business profile before previewing it.</div>
    }
    else
    {
        <article class="quotation-document" aria-label="Quotation document">
            <header class="quotation-document-header">
                <div>
                    <div class="quotation-document-brand"><img src="~/brand/buildwise-mark-muted.svg" alt="" /><span>BuildWise</span></div>
                    @if (Model.Entry.CompanySnapshot.LogoUrl is not null)
                    {
                        <img class="quotation-company-logo" src="@Model.Entry.CompanySnapshot.LogoUrl" alt="Company logo" />
                    }
                    <h2>@Model.Entry.CompanySnapshot.Name</h2>
                    <p class="quotation-copy">@Model.Entry.CompanySnapshot.Address</p>
                    <p>@Model.Entry.CompanySnapshot.Email</p>
                    <p>@Model.Entry.CompanySnapshot.Phone</p>
                    @if (Model.Entry.CompanySnapshot.RegistrationNumber != "")
                    {
                        <p>Registration: @Model.Entry.CompanySnapshot.RegistrationNumber</p>
                    }
                    @if (Model.Entry.CompanySnapshot.TaxNumber != "")
                    {
                        <p>Tax number: @Model.Entry.CompanySnapshot.TaxNumber</p>
                    }
                </div>
                <div class="quotation-document-reference">
                    <div class="eyebrow">QUOTATION</div>
                    <h2>@Model.Entry.Number</h2>
                    <p>Revision @Model.Entry.Quotation.Revision · @Model.Entry.Quotation.Status</p>
                    <p>@Model.Entry.Quotation.PreparedOn.ToString("dd MMM yyyy")</p>
                    <p>Valid until @Model.Entry.Quotation.PreparedOn.AddDays(Model.Entry.CompanySnapshot.DefaultValidityDays).ToString("dd MMM yyyy")</p>
                </div>
            </header>

            <div class="quotation-document-customer">
                <div>
                    <div class="eyebrow">PREPARED FOR</div>
                    <h3>@Model.SourceRequest.Request.Customer</h3>
                    <p>@Model.SourceRequest.Location</p>
                    @if (!string.IsNullOrWhiteSpace(Model.SourceRequest.Email))
                    {
                        <p>@Model.SourceRequest.Email</p>
                    }
                </div>
                <div>
                    <div class="eyebrow">SOURCE REQUEST</div>
                    <h3>REQ-@Model.SourceRequest.Request.Id</h3>
                    <p>@Model.SourceRequest.Request.Title</p>
                </div>
            </div>

            <h2>Scope of work</h2>
            <p>The following work and pricing are subject to the terms and exclusions below.</p>
            @await Html.PartialAsync("_QuotationLines", Model.Entry)

            <section class="quotation-document-terms">
                <h3>Terms and validity</h3>
                <p class="quotation-copy">@Model.Entry.Terms</p>
                <h3>Exclusions</h3>
                <p class="quotation-copy">@Model.Entry.Exclusions</p>
            </section>
            <footer class="quotation-document-footer">@Model.Entry.Number · @Model.Entry.CompanySnapshot.Name · All amounts in USD</footer>
        </article>
    }
</div>

@section Scripts {
    <script src="~/js/quotation-preview.js" asp-append-version="true"></script>
}
