@page
@model BuildWise.Web.Pages.Requests.CreateModel
@{
    ViewData["Title"] = "New request";
    ViewData["ActiveSection"] = "requests";
    ViewData["AccountName"] = "Tawanda M.";
    ViewData["AccountRole"] = "Business owner";
}
@section Styles { <link rel="stylesheet" href="~/css/requests.css" asp-append-version="true" /> }
<div class="requests-page">
    <a class="request-back" asp-page="Index">← Back to requests</a>
    <header class="requests-heading"><div><div class="eyebrow">NEW CUSTOMER REQUEST</div><h1>Let’s understand the work.</h1><p>Capture the customer’s details and what they need done.</p></div></header>
    <div class="request-detail-grid">
        <form method="post" class="panel request-detail-panel request-form">
            <div asp-validation-summary="All" class="request-validation" role="alert"></div>
            <h2>Customer &amp; location</h2>
            <div class="request-form-fields">
                <div class="field"><label asp-for="Input.Customer">Customer name <span>*</span></label><input asp-for="Input.Customer" autocomplete="name" required maxlength="100" placeholder="Full name or business name" /><span asp-validation-for="Input.Customer"></span></div>
                <div class="field"><label asp-for="Input.Email">Email address <small>Optional</small></label><input asp-for="Input.Email" type="email" autocomplete="email" maxlength="200" placeholder="customer@example.com" /><span asp-validation-for="Input.Email"></span></div>
                <div class="field request-form-wide"><label asp-for="Input.Location">Site location <span>*</span></label><input asp-for="Input.Location" required maxlength="200" placeholder="Street address or area" /><span asp-validation-for="Input.Location"></span></div>
            </div>
            <h2>What work is needed?</h2>
            <div class="field"><label asp-for="Input.Title">Request title <span>*</span></label><input asp-for="Input.Title" required maxlength="120" placeholder="e.g. Electrical installation" /><span asp-validation-for="Input.Title"></span></div>
            <div class="field"><label asp-for="Input.Category">Service category <span>*</span></label><select asp-for="Input.Category" required><option value="">Select a service</option>@foreach (var category in Model.Categories) { <option>@category</option> }</select><span asp-validation-for="Input.Category"></span></div>
            <div class="field"><label asp-for="Input.Description">Customer’s description <span>*</span></label><textarea asp-for="Input.Description" required minlength="20" maxlength="3000" rows="5" placeholder="Describe the work, affected areas and any specific requirements."></textarea><span asp-validation-for="Input.Description"></span></div>
            <div class="request-form-actions"><button class="btn primary" type="submit">@await Html.PartialAsync("_WorkspaceIcon", "plus")<span>Create request</span></button><a class="btn" asp-page="Index">Cancel</a></div>
        </form>
        <aside class="request-workflow-note request-form-help">@await Html.PartialAsync("_WorkspaceIcon", "help")<div><h2>Start simple. Add clarity.</h2><p>Record what the customer knows now. Missing details can be clarified before the scope and quotation are prepared.</p><ul><li>Describe the work and its location.</li><li>Include measurements when available.</li><li>Note preferred materials or finishes.</li></ul><p>Fields marked * are required.</p></div></aside>
    </div>
</div>
