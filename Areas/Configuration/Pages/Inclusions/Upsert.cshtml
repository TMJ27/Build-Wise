@page "{id:guid?}"
@model BuildWise.Web.Areas.Configuration.Pages.Inclusions.UpsertModel
@{
    var editing = Model.Input.Id.HasValue;
    ViewData["Title"] = editing ? "Edit inclusion" : "Add inclusion";
    ViewData["PageTitle"] = ViewData["Title"];
    ViewData["PageSubTitle"] = "Define reusable work, materials and deliverables included in your quotations.";
    ViewData["Breadcrumbs"] = new BreadcrumbItem[]
    {
        new("Configuration"),
        new("Inclusions", Url.Page("/Inclusions/Index", new { area = "Configuration", id = (Guid?)null }))
    };
}

<div class="requests-page configuration-page">
    <form method="post" class="form-stack">
        <input type="hidden" asp-for="Input.Id" />
        <div asp-validation-summary="All" class="configuration-errors" role="alert"></div>
        <section class="panel configuration-section form-panel">
            <h2>Inclusion details</h2>
            <div class="form-fields">
                <div class="field form-wide">
                    <label asp-for="Input.Name">Name <span>*</span></label>
                    <input class="form-control" asp-for="Input.Name" required maxlength="150" placeholder="For example, surface preparation and materials" />
                    <span asp-validation-for="Input.Name"></span>
                </div>
                <div class="field form-wide">
                    <label asp-for="Input.Description">Description <span>*</span></label>
                    <textarea class="form-control" asp-for="Input.Description" rows="5" required maxlength="4000" aria-describedby="inclusion-description-help"></textarea>
                    <small id="inclusion-description-help">Describe the work, materials or deliverables included.</small>
                    <span asp-validation-for="Input.Description"></span>
                </div>
            </div>
            <label class="form-check">
                <input asp-for="Input.IsActive" />
                <span>
                    <strong>Active inclusion</strong>
                    <small>Available when preparing quotation inclusions.</small>
                </span>
            </label>
        </section>
        <div class="form-actions">
            @* Enable the submit button after implementing the save handler. *@
            <button class="btn primary" type="submit" disabled aria-describedby="save-availability">
                <i class="fa-solid fa-check" aria-hidden="true"></i>
                <span>@(editing ? "Save changes" : "Create inclusion")</span>
            </button>
        </div>
        <p id="save-availability">Saving is not available yet.</p>
    </form>
</div>
