@page "{id:guid?}"
@model BuildWise.Web.Areas.Scopes.Pages.Dependencies.UpsertModel
@{
    var editing = Model.Input.Id.HasValue;
    ViewData["Title"] = editing ? "Edit scope dependency" : "Add scope dependency";
    ViewData["PageTitle"] = ViewData["Title"];
    ViewData["PageSubTitle"] = "Choose the work item that must be completed first.";
    ViewData["Breadcrumbs"] = new BreadcrumbItem[]
    {
        new("Scope", Url.Page("/Index", new { area = "Scopes", id = (Guid?)null, scopeItemId = (Guid?)null })),
        new("Request scope", Url.Page("/Details", new { area = "Scopes", id = Model.RequestId, scopeItemId = (Guid?)null })),
        new("Scope item", Url.Page("/Items/Details", new { area = "Scopes", id = Model.Input.ScopeItemId, requestId = Model.RequestId, scopeItemId = (Guid?)null })),
        new("Dependencies", Url.Page("/Dependencies/Index", new { area = "Scopes", id = (Guid?)null, scopeItemId = Model.Input.ScopeItemId, requestId = (Guid?)null }))
    };
}

<div class="requests-page">
    <form method="post" class="form-stack" asp-route-id="@Model.Input.Id" asp-route-scopeItemId="@Model.Input.ScopeItemId">
        <input type="hidden" asp-for="Input.Id" />
        <input type="hidden" asp-for="Input.ScopeItemId" />
        <div asp-validation-summary="All" class="configuration-errors" role="alert"></div>
        <section class="panel configuration-section form-panel">
            <h2>Dependency details</h2>
            <div class="form-fields">
                <div class="field form-wide">
                    <label>Scope item</label>
                    <p>@Model.ScopeItemTitle</p>
                </div>
                <div class="field form-wide">
                    <label asp-for="Input.DependsOnScopeItemId">Depends on <span>*</span></label>
                    <select class="form-control" asp-for="Input.DependsOnScopeItemId" asp-items="Model.Prerequisites" required aria-describedby="dependency-help">
                        <option value="">Choose the work that must happen first</option>
                    </select>
                    <small id="dependency-help">Only other scope items from the same request are available.</small>
                    <span asp-validation-for="Input.DependsOnScopeItemId"></span>
                    @if (Model.Prerequisites.Count == 0)
                    {
                        <p>Add another scope item to this request before creating a dependency.</p>
                    }
                </div>
                <div class="field form-wide">
                    <label asp-for="Input.Notes">Notes</label>
                    <textarea class="form-control" asp-for="Input.Notes" rows="4" maxlength="4000" placeholder="Explain why this work must happen first."></textarea>
                    <span asp-validation-for="Input.Notes"></span>
                </div>
            </div>
            <p>Adding or changing a dependency returns this scope item to pending review.</p>
        </section>
        <div class="form-actions">
            <button class="btn primary" type="submit">
                <i class="fa-solid fa-check" aria-hidden="true"></i>
                <span>@(editing ? "Save changes" : "Create dependency")</span>
            </button>
        </div>
    </form>
</div>
