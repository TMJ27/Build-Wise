@model BuildWise.Web.Services.QuotationEntry

<div class="table-wrap quotation-lines-wrap" tabindex="0" role="region" aria-label="Quotation pricing; scroll horizontally on smaller screens">
    <table class="quotation-lines">
        <thead>
            <tr>
                <th>Description</th>
                <th>Quantity</th>
                <th>Rate</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.Description</td>
                    <td>@line.Quantity.ToString("0.##")</td>
                    <td>@BuildWise.Web.Pages.IndexModel.Money(line.Rate)</td>
                    <td>@BuildWise.Web.Pages.IndexModel.Money(line.Total)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3">Total (USD)</th>
                <td>@BuildWise.Web.Pages.IndexModel.Money(Model.Quotation.Amount)</td>
            </tr>
        </tfoot>
    </table>
</div>
