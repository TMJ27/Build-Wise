@page
@model BuildWise.Web.Areas.CustomerPortal.Pages.Account.ResetPasswordModel
@{
    Layout = "/Pages/Shared/_CustomerPublicLayout.cshtml";
    ViewData["Title"] = "Reset password";
    ViewData["CustomerAuth"] = true;
}
<section aria-labelledby="reset-title">
    <p class="eyebrow">ACCOUNT RECOVERY</p>
    <h2 id="reset-title">Choose a new password.</h2>
    @if (!Model.LinkValid)
    {
        <div class="auth-alert" role="alert">This password reset link is invalid, expired or already used.</div>
        <p><a asp-page="ForgotPassword">Request a new reset link</a></p>
    }
    else
    {
        <form method="post" asp-route-token="" class="auth-form">
            <input asp-for="Input.Token" type="hidden" />
            <div asp-validation-summary="All" class="auth-alert" role="alert"></div>
            <div class="auth-field">
                <label asp-for="Input.Password">New password <span>*</span></label>
                <input asp-for="Input.Password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required aria-describedby="reset-password-help" />
                <small id="reset-password-help">Use at least 12 characters.</small>
                <span class="field-error" asp-validation-for="Input.Password"></span>
            </div>
            <div class="auth-field">
                <label asp-for="Input.ConfirmPassword">Confirm password <span>*</span></label>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" maxlength="128" required />
                <span class="field-error" asp-validation-for="Input.ConfirmPassword"></span>
            </div>
            <button class="auth-button" type="submit"><span>Reset password</span></button>
        </form>
    }
    <p class="auth-footnote"><a asp-page="Login">Return to sign in</a></p>
</section>
