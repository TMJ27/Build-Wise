@page
@model BuildWise.Web.Areas.Quotations.Pages.IndexModel
@using BuildWise.Lib.Enums.Statuses
@{
    ViewData["Title"] = "Quotations";
    ViewData["PageTitle"] = ViewData["Title"];
    ViewData["PageSubTitle"] = "Manage customer quotations and their latest revisions.";
    var upsertUrl = Url.Page("/Upsert", new { area = "Quotations" });
}

@section actionbar {
    @if (upsertUrl is not null)
    {
        <a class="btn primary" href="@upsertUrl">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            <span>Create quotation</span>
        </a>
    }
    else
    {
        <button class="btn primary" type="button" disabled title="The quotation Upsert page is not available yet.">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            <span>Create quotation</span>
        </button>
    }
}

<div class="requests-page quotations-page">
    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="request-success" role="status">@message</div>
    }

    <div class="request-summary" aria-label="Quotation summary">
        <a class="request-summary-card" asp-page="Index">
            <span class="summary-icon">
                <i class="fa-solid fa-file-invoice-dollar" aria-hidden="true"></i>
            </span>
            <span>
                <span class="summary-label">Total quotations</span>
                <strong>@Model.Summary.TotalCount.ToString("D2")</strong>
            </span>
        </a>
        <a class="request-summary-card" asp-page="Index" asp-route-status="@QuotationStatus.Draft">
            <span class="summary-icon">
                <i class="fa-solid fa-pen" aria-hidden="true"></i>
            </span>
            <span>
                <span class="summary-label">Draft quotations</span>
                <strong>@Model.Summary.DraftCount.ToString("D2")</strong>
            </span>
        </a>
        <a class="request-summary-card" asp-page="Index" asp-route-status="@QuotationStatus.Approved">
            <span class="summary-icon">
                <i class="fa-solid fa-check" aria-hidden="true"></i>
            </span>
            <span>
                <span class="summary-label">Approved quotations</span>
                <strong>@Model.Summary.ApprovedCount.ToString("D2")</strong>
            </span>
        </a>
        <div class="request-summary-card">
            <span class="summary-icon">
                <i class="fa-solid fa-coins" aria-hidden="true"></i>
            </span>
            <span>
                <span class="summary-label">Priced quotations</span>
                <strong>@Model.Summary.PricedCount.ToString("D2")</strong>
            </span>
        </div>
    </div>

    <section class="panel requests-panel">
        <div class="requests-panel-heading">
            <div>
                <h2>Quotation register</h2>
                <p>One entry per quotation, showing its latest revision.</p>
            </div>
        </div>

        <form method="get" class="form-filters" role="search">
            <label class="form-search">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <span class="sr-only">Search quotations</span>
                <input class="form-control" asp-for="Search" type="search" maxlength="120" placeholder="Search quotation number, title or customer..." />
            </label>
            <label class="form-filter">
                <span>Status</span>
                <select class="form-control" asp-for="Status" asp-items="Html.GetEnumSelectList<QuotationStatus>()">
                    <option value="">All statuses</option>
                </select>
            </label>
            <label class="form-filter">
                <span>Sort by</span>
                <select class="form-control" asp-for="Sort">
                    <option value="newest">Newest first</option>
                    <option value="oldest">Oldest first</option>
                    <option value="customer">Customer name</option>
                </select>
            </label>
            <button class="btn" type="submit">Apply filters</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.Status.HasValue || Model.Sort != "newest")
            {
                <a class="request-clear" asp-page="Index">Clear filters</a>
            }
        </form>

        <div class="table-wrap">
            <table class="configuration-table">
                <caption class="sr-only">Quotations matching the selected filters</caption>
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Title</th>
                        <th scope="col">Customer</th>
                        <th scope="col">Status</th>
                        <th scope="col">Revision</th>
                        <th scope="col">Amount</th>
                        <th scope="col">Currency</th>
                        <th scope="col">Creator</th>
                        <th scope="col">Creation date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var quotation in Model.Quotations)
                    {
                        var detailsUrl = Url.Page("/Upsert", new { area = "Quotations", id = quotation.Id });
                        <tr>
                            <td>
                                @if (detailsUrl is not null)
                                {
                                    <a class="record-link record-id" href="@detailsUrl">
                                        @quotation.QuotationNumber
                                        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="record-id">@quotation.QuotationNumber</span>
                                }
                            </td>
                            <td>@quotation.Title</td>
                            <td>@quotation.CustomerName</td>
                            <td>
                                <span class="badge @(quotation.Status == QuotationStatus.Approved ? "green" : null)">@(quotation.Status?.ToString() ?? "Not set")</span>
                            </td>
                            <td>@quotation.RevisionNumber</td>
                            <td>@(quotation.IncludesPrices ? quotation.Total?.ToString("N2") ?? "Not set" : "Not priced")</td>
                            <td>@(quotation.IncludesPrices ? quotation.CurrencyCode ?? "Not set" : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(quotation.CreatorName) ? "Not provided" : quotation.CreatorName)</td>
                            <td>@(quotation.CreationDate?.ToString("dd MMM yyyy, HH:mm") ?? "Not set")</td>
                        </tr>
                    }
                    @if (Model.Quotations.Count == 0)
                    {
                        <tr>
                            <td colspan="9">@(Model.Summary.TotalCount == 0 ? "No quotations have been added." : "No quotations match the selected filters.")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="requests-table-footer">
            <span>@Model.Quotations.Count of @Model.FilteredCount quotations shown</span>
            @if (Model.PageCount > 1)
            {
                <nav class="request-pagination" aria-label="Quotation pages">
                    @if (Model.PageNumber > 1)
                    {
                        <a class="btn" asp-page="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-status="@Model.Status" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort">Previous</a>
                    }
                    <span>Page @Model.PageNumber of @Model.PageCount</span>
                    @if (Model.PageNumber < Model.PageCount)
                    {
                        <a class="btn" asp-page="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-status="@Model.Status" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort">Next</a>
                    }
                </nav>
            }
        </div>
    </section>
</div>
