@page "{id:guid?}"
@model BuildWise.Web.Areas.Configuration.Pages.Currency.IndexModel
@{
    ViewData["Title"] = "Currency";
    var editing = Model.Input.Id.HasValue;

    ViewData["PageTitle"] = "Currency";
    ViewData["PageSubTitle"] = "Manage the currencies available for your company's base currency.";
    ViewData["Breadcrumbs"] = new BreadcrumbItem[]
    {
        new("Configuration")
    };
}

@section actionbar {
    @if (editing)
    {
        <a class="btn primary" asp-page="/Currency/Index" asp-route-id="">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            <span>Add currency</span>
        </a>
    }
}

<div class="requests-page configuration-page">

    @if (TempData["CurrencyMessage"] is string message)
    {
        <div class="request-success" role="status">@message</div>
    }

    <div class="configuration-grid configuration-register">
        <section class="panel configuration-section">
            <div class="configuration-preview-heading">
                <h2>Currency register</h2>
                <span class="badge">@Model.Currencies.Count currencies</span>
            </div>
            <div class="table-wrap">
                <table class="configuration-table">
                    <caption class="sr-only">Registered currencies</caption>
                    <thead><tr><th>Name</th><th>Code</th><th>Symbol</th><th>Creator</th><th>Creation date</th><th><span class="sr-only">Actions</span></th></tr></thead>
                    <tbody>
                        @foreach (var currency in Model.Currencies)
                        {
                            <tr>
                                <td>@currency.Name</td>
                                <td>@currency.Code</td>
                                <td>@currency.Symbol</td>
                                <td>@currency.Creator</td>
                                <td>@currency.CreationDate.ToString("dd MMM yyyy")</td>
                                <td><a class="btn small" asp-page="/Currency/Index" asp-route-id="@currency.Id">Edit</a></td>
                            </tr>
                        }
                        @if (Model.Currencies.Count == 0)
                        {
                            <tr><td colspan="6">No currencies have been added. Add one using the form.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <form method="post" class="panel configuration-section request-form">
            <h2>@(editing ? "Edit currency" : "Add currency")</h2>
            <input type="hidden" asp-for="Input.Id" />
            <div asp-validation-summary="All" class="configuration-errors" role="alert"></div>

            <div class="field">
                <label asp-for="Input.Name">Name</label>
                <input asp-for="Input.Name" required maxlength="80" />
                <span asp-validation-for="Input.Name"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Code">Code</label>
                <input asp-for="Input.Code" required minlength="3" maxlength="3" readonly="@editing" aria-describedby="currency-code-help" />
                <span asp-validation-for="Input.Code"></span>
                <p id="currency-code-help" class="configuration-muted">Three letters. The code stays fixed once created.</p>
            </div>
            <div class="field">
                <label asp-for="Input.Symbol">Symbol</label>
                <input asp-for="Input.Symbol" required maxlength="10" />
                <span asp-validation-for="Input.Symbol"></span>
            </div>
            <div class="field">
                <label asp-for="Input.CreatorId">Creator</label>
                @if (editing)
                {
                    <input type="hidden" asp-for="Input.CreatorId" />
                    <input value="@Model.Creators.FirstOrDefault(user => user.Id == Model.Input.CreatorId)?.Name" readonly />
                }
                else
                {
                    <select asp-for="Input.CreatorId" required>
                        <option value="">Select a user</option>
                        @foreach (var user in Model.Creators)
                        {
                            <option value="@user.Id">@user.Name</option>
                        }
                    </select>
                    @if (Model.Creators.Count == 0)
                    {
                        <p class="configuration-muted">A user record is needed before a currency can be added.</p>
                    }
                }
                <span asp-validation-for="Input.CreatorId"></span>
            </div>
            <p class="configuration-muted">The creation date is recorded automatically.</p>
            <div class="configuration-actions configuration-form-actions">
                <button class="btn primary" type="submit">@(editing ? "Save changes" : "Add currency")</button>
                @if (editing)
                {
                    <a class="btn" asp-page="/Currency/Index" asp-route-id="">Cancel</a>
                }
            </div>
        </form>
    </div>
</div>
