@page "{id:guid?}"
@model BuildWise.Web.Areas.Scopes.Pages.Stages.UpsertModel
@{
    var editing = Model.Input.Id.HasValue;
    ViewData["Title"] = editing ? "Edit scope stage" : "Add scope stage";
    ViewData["PageTitle"] = ViewData["Title"];
    ViewData["PageSubTitle"] = "Describe a step in completing this work item.";
    ViewData["Breadcrumbs"] = new BreadcrumbItem[]
    {
        new("Scope", Url.Page("/Index", new { area = "Scopes", id = (Guid?)null, scopeItemId = (Guid?)null })),
        new("Request scope", Url.Page("/Details", new { area = "Scopes", id = Model.RequestId, scopeItemId = (Guid?)null })),
        new("Scope item", Url.Page("/Items/Details", new { area = "Scopes", id = Model.Input.ScopeItemId, requestId = Model.RequestId, scopeItemId = (Guid?)null })),
        new("Stages", Url.Page("/Stages/Index", new { area = "Scopes", id = (Guid?)null, scopeItemId = Model.Input.ScopeItemId, requestId = (Guid?)null }))
    };
}

<div class="requests-page">
    <form method="post" class="form-stack" asp-route-id="@Model.Input.Id" asp-route-scopeItemId="@Model.Input.ScopeItemId">
        <input type="hidden" asp-for="Input.Id" />
        <input type="hidden" asp-for="Input.ScopeItemId" />
        <div asp-validation-summary="All" class="configuration-errors" role="alert"></div>
        <section class="panel configuration-section form-panel">
            <h2>Stage details</h2>
            <div class="form-fields">
                <div class="field form-wide">
                    <label>Scope item</label>
                    <p>@Model.ScopeItemTitle</p>
                </div>
                <div class="field form-wide">
                    <label asp-for="Input.Name">Name <span>*</span></label>
                    <input class="form-control" asp-for="Input.Name" required maxlength="50" placeholder="For example, prepare surfaces" />
                    <span asp-validation-for="Input.Name"></span>
                </div>
                <div class="field form-wide">
                    <label asp-for="Input.Description">Description</label>
                    <textarea class="form-control" asp-for="Input.Description" rows="4" maxlength="4000" placeholder="Describe what happens during this stage."></textarea>
                    <span asp-validation-for="Input.Description"></span>
                </div>
            </div>
            <p>Adding or changing a stage returns the scope item to pending review.</p>
        </section>
        <div class="form-actions">
            <button class="btn primary" type="submit">
                <i class="fa-solid fa-check" aria-hidden="true"></i>
                <span>@(editing ? "Save changes" : "Create stage")</span>
            </button>
        </div>
    </form>
</div>
