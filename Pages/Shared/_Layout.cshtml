@using System.Text.Json
@{
    var title = ViewData["Title"]?.ToString() ?? "Workspace";


    var fullWidth = ViewData["UseFullWidthLayout"] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#14233b" />
    <title>@title · BuildWise</title>
    <link rel="icon" type="image/svg+xml" href="~/brand/buildwise-mark-muted.svg" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/fontawesome.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/solid.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="workspace-page" data-server-shell="@(!fullWidth ? "true" : "false")" data-native-dashboard="@(ViewData["NativeDashboard"] is true ? "true" : "false")">
    <a class="skip-link" href="#main-content">Skip to content</a>
    @if (fullWidth)
    {
        <main id="main-content" class="public-wrapper" tabindex="-1">@RenderBody()</main>
        IgnoreSection("actionbar");
    }
    else
    {
        @if (ViewData["CustomerPortal"] is true)
        {
            var customerName = ViewData["CustomerName"]?.ToString() ?? "Customer account";
            var customerInitials = string.Concat(customerName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
            var customerPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
            <header class="v2-header">
                <a class="brand" asp-area="CustomerPortal" asp-page="/Index"><img src="~/brand/buildwise-mark-muted.svg" alt="" />BuildWise</a>
                <div class="v2-header-right">
                    <span class="avatar" aria-hidden="true">@customerInitials</span>
                    <div class="v2-owner"><b class="workspace-account-name">@customerName</b><small class="workspace-account-role">Customer</small></div>
                    <form method="post" asp-area="CustomerPortal" asp-page="/Account/Logout">
                        <button class="icon-btn" type="submit" aria-label="Sign out" title="Sign out"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i></button>
                    </form>
                    <button class="icon-btn v2-mobile-menu" type="button" data-workspace-menu aria-controls="workspace-navigation" aria-expanded="false" aria-label="Open navigation"><i class="fa-solid fa-bars" aria-hidden="true"></i></button>
                </div>
            </header>
            <aside class="v2-rail workspace-sidebar" id="workspace-navigation" aria-label="Customer navigation">
                <nav class="workspace-nav-group" aria-label="My account">
                    <div class="workspace-nav-heading">MY ACCOUNT</div>
                    <a asp-area="CustomerPortal" asp-page="/Index" class="@(customerPage == "/Index" ? "active" : null)" aria-current="@(customerPage == "/Index" ? "page" : null)">
                        <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i><span>My dashboard</span>
                    </a>
                    <a asp-area="CustomerPortal" asp-page="/Index" asp-fragment="my-requests">
                        <i class="fa-solid fa-file-lines" aria-hidden="true"></i><span>My requests</span>
                    </a>
                    <a asp-area="CustomerPortal" asp-page="/Index" asp-fragment="my-quotations">
                        <i class="fa-solid fa-file-invoice-dollar" aria-hidden="true"></i><span>My quotations</span>
                    </a>
                    <a asp-area="CustomerPortal" asp-page="/Account/Settings" class="@(customerPage == "/Account/Settings" ? "active" : null)" aria-current="@(customerPage == "/Account/Settings" ? "page" : null)">
                        <i class="fa-solid fa-user-gear" aria-hidden="true"></i><span>Account settings</span>
                    </a>
                </nav>
            </aside>
            <button type="button" class="workspace-nav-backdrop" tabindex="-1" aria-label="Close navigation"></button>
        }
        else
        {
            @await Html.PartialAsync("_WorkspaceHeader")
            @await Html.PartialAsync("_Sidebar")
        }
        <main class="v2-main" id="main-content" tabindex="-1">
            <div class="content">
                @if (ViewData["HideBreadcrumbs"] is not true)
                {
                    @await Html.PartialAsync("_Breadcrumbs")
                }
                @if (ViewData["PageTitle"] is not null || IsSectionDefined("actionbar"))
                {
                    <header class="page-head @ViewData["PageHeaderClass"]">
                        <div class="page-heading-identity">
                            @if (ViewData["PageInitials"] is not null)
                            {
                                <span class="customer-avatar customer-avatar-large" aria-hidden="true">@ViewData["PageInitials"]</span>
                            }
                            <div>
                                @if (ViewData["PageTitle"] is not null)
                                {
                                    <h1>@ViewData["PageTitle"]</h1>
                                }
                                @if (ViewData["PageSubTitle"] is not null)
                                {
                                    <p>@ViewData["PageSubTitle"]</p>
                                }
                            </div>
                        </div>
                        @if (IsSectionDefined("actionbar"))
                        {
                            <div class="actions">
                                @await RenderSectionAsync("actionbar", required: false)
                            </div>
                        }
                    </header>
                }
                @RenderBody()
                <footer class="footer-note"><span>© @DateTime.Now.Year BuildWise · Built for the way you work.</span></footer>
            </div>
        </main>
    }
    <div id="toast" role="status" aria-live="polite"></div>
    <dialog id="modal" aria-label="Workspace dialog"><div id="modal-content"></div></dialog>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-ui.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>
    <script src="~/js/workspace.js" asp-append-version="true"></script>
    <script src="~/js/date-picker.js" asp-append-version="true"></script>
    <script src="~/js/business-profile.js" asp-append-version="true"></script>
    <script src="~/js/rights-selector.js" asp-append-version="true"></script>
    @if (ViewData["QuotationPdfData"] is { } quotationPdfData)
    {
        <script id="quotation-pdf-data" type="application/json"
                data-font-regular="@Url.Content("~/fonts/NotoSans-Regular.ttf")"
                data-font-bold="@Url.Content("~/fonts/NotoSans-Bold.ttf")">@Html.Raw(JsonSerializer.Serialize(quotationPdfData))</script>
        <script src="~/lib/jspdf/jspdf.umd.min.js" asp-append-version="true"></script>
        <script src="~/lib/jspdf/jspdf.plugin.autotable.min.js" asp-append-version="true"></script>
        <script src="~/js/quotation-pdf.js" asp-append-version="true"></script>
    }
    <script src="~/js/quotation-preview.js" asp-append-version="true"></script>
    @if (ViewData["DashboardChartData"] is { } chartData)
    {
        <script id="dashboard-chart-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(chartData))</script>
        <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
        <script src="~/js/dashboard-charts.js" asp-append-version="true"></script>
        <script src="~/js/dashboard-records.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
