@page
@model BuildWise.Web.Areas.Configuration.Pages.UserGroups.IndexModel
@{
    ViewData["Title"] = "User groups";

    ViewData["PageTitle"] = "User groups";
    ViewData["PageSubTitle"] = "The groups used to organise system users.";
    ViewData["Breadcrumbs"] = new BreadcrumbItem[]
    {
        new("Configuration")
    };
}

@section actionbar {
    <a class="btn primary" asp-area="Configuration" asp-page="/UserGroups/Upsert">
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
        <span>Add user group</span>
    </a>
}

<div class="requests-page configuration-page">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="request-success" role="status">
            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
            <span>@successMessage</span>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="request-validation" role="alert">
            <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
            <span>@errorMessage</span>
        </div>
    }

    <section class="panel configuration-section">
        <div class="configuration-preview-heading">
            <h2>User group register</h2>
            <span class="badge">
                @Model.UserGroups.Count @(Model.UserGroups.Count == 1 ? "group" : "groups")
            </span>
        </div>

        <div class="table-wrap">
            <table class="configuration-table configuration-groups-table">
                <caption class="sr-only">System user groups</caption>
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Group name</th>
                        <th scope="col">Creation date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in Model.UserGroups)
                    {
                        <tr>
                            <td>
                                <a class="record-link record-id" asp-area="Configuration" asp-page="/UserGroups/Details" asp-route-id="@group.Id">
                                    @group.UserGroupNumber
                                    <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                                </a>
                            </td>
                            <td>
                                @group.Name
                            </td>
                            <td>@group.CreationDate.ToString("dd MMM yyyy, HH:mm")</td>
                        </tr>
                    }

                    @if (Model.UserGroups.Count == 0)
                    {
                        <tr>
                            <td colspan="3">No user groups have been added.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
