@page
@model BuildWise.Web.Pages.Configuration.AccessModel
@{
    ViewData["Title"] = "Access & integrations";
    ViewData["ActiveSection"] = "settings-access";
    ViewData["AccountName"] = "Tawanda M.";
    ViewData["AccountRole"] = "Business owner";
}

@section Styles {
    <link rel="stylesheet" href="~/css/requests.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/configuration.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/access.css" asp-append-version="true" />
}

<div class="requests-page access-page">
    <header class="requests-heading">
        <div>
            <div class="eyebrow">CONFIGURATION / ACCESS &amp; INTEGRATIONS</div>
            <h1>Access &amp; integrations</h1>
            <p>Manage your team’s roles and the tools behind your quotations.</p>
        </div>
        <a class="btn primary" asp-page="Member">
            @await Html.PartialAsync("_WorkspaceIcon", "plus")
            <span>Add team member</span>
        </a>
    </header>

    @if (TempData["AccessMessage"] is string message)
    {
        <div class="request-success" role="status">
            @await Html.PartialAsync("_WorkspaceIcon", "check")
            @message
        </div>
    }

    <section class="panel request-detail-panel access-owner-panel">
        <div class="access-owner-identity">
            <span class="access-avatar access-owner-avatar" aria-hidden="true">@Model.Owner.Initials</span>
            <div>
                <div class="eyebrow">WORKSPACE OWNER</div>
                <h2>@Model.Owner.Name</h2>
                <p>@Model.Owner.Email · @Model.CompanyName</p>
            </div>
        </div>
        <div class="access-owner-stats">
            <div><strong>@Model.ActiveCount.ToString("D2")</strong><span>Active members</span></div>
            <div><strong>@Model.ApprovalCount.ToString("D2")</strong><span>With approval access</span></div>
        </div>
    </section>

    <section class="panel requests-panel" aria-labelledby="team-heading">
        <div class="requests-panel-heading">
            <div><h2 id="team-heading">Your team</h2><p>Choose who prepares requests, reviews work and approves quotations.</p></div>
            <span class="badge">@Model.Members.Count members</span>
        </div>
        <div class="table-wrap requests-table-wrap" tabindex="0" role="region" aria-label="Team members; scroll horizontally on smaller screens">
            <table class="requests-table access-team-table">
                <thead>
                    <tr><th>Team member</th><th>Role</th><th>Quotation approval</th><th>Status</th><th><span class="visually-hidden">Manage member</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var member in Model.Members)
                    {
                        <tr>
                            <td>
                                <div class="access-member-identity">
                                    <span class="access-avatar" aria-hidden="true">@member.Initials</span>
                                    <span><strong>@member.Name</strong><small>@member.Email</small></span>
                                </div>
                            </td>
                            <td class="access-muted">@member.Role</td>
                            <td><span class="access-permission @(member.CanApprove ? "allowed" : null)">@await Html.PartialAsync("_WorkspaceIcon", member.CanApprove ? "check" : "file")<span>@(member.CanApprove ? "Can approve" : "No approval access")</span></span></td>
                            <td><span class="badge @(member.IsActive ? "green" : "")">@(member.IsActive ? "Active" : "Inactive")</span></td>
                            <td>
                                @if (member.Role == "Owner")
                                {
                                    <span class="access-owner-label">Owner</span>
                                }
                                else
                                {
                                    <a class="btn small" asp-page="Member" asp-route-id="@member.Id" aria-label="Edit @member.Name">Edit</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <details class="access-role-guide">
            <summary>@await Html.PartialAsync("_WorkspaceIcon", "shield")<span>Understand team roles</span></summary>
            <div class="access-role-grid">
                <div><h3>Owner &amp; Administrator</h3><p>Manage the workspace, prepare work and approve quotations.</p></div>
                <div><h3>Estimator</h3><p>Prepare customer requests, scope details and quotation drafts.</p></div>
                <div><h3>Viewer</h3><p>Review records without editing work or approving quotations.</p></div>
            </div>
        </details>
    </section>

    <div class="access-section-heading">
        <div><h2>Connected tools</h2><p>Set up optional assistance and delivery for your workspace.</p></div>
        <span class="access-muted">Connections are optional</span>
    </div>

    <div class="access-integration-grid">
        <article class="panel access-integration-card">
            <div class="access-integration-top"><span class="summary-icon">@await Html.PartialAsync("_WorkspaceIcon", "spark")</span><span class="badge">Not connected</span></div>
            <h2>AI assistance</h2>
            <p>Help match catalogue services, identify missing details and prepare a scope for your review.</p>
            <div class="access-integration-note">Your approval remains part of the quotation workflow.</div>
            <div class="access-integration-footer">
                <span>@(Model.AiConfigured ? "Preferences saved" : "Not configured")</span>
                <a class="btn" asp-page="Integration" asp-route-kind="ai">Configure AI</a>
            </div>
        </article>

        <article class="panel access-integration-card">
            <div class="access-integration-top"><span class="summary-icon">@await Html.PartialAsync("_WorkspaceIcon", "mail")</span><span class="badge">Not connected</span></div>
            <h2>Email delivery</h2>
            <p>Choose a sending service and the company details customers should see on quotation emails.</p>
            <div class="access-integration-note">Confirm the recipient and document before sending.</div>
            <div class="access-integration-footer">
                <span>@(Model.EmailConfigured ? "Preferences saved" : "Not configured")</span>
                <a class="btn" asp-page="Integration" asp-route-kind="email">Configure email</a>
            </div>
        </article>

        <article class="panel access-integration-card">
            <div class="access-integration-top"><span class="summary-icon">@await Html.PartialAsync("_WorkspaceIcon", "file")</span><span class="badge green">Available</span></div>
            <h2>Document output</h2>
            <p>Preview, print and save quotation documents using the browser’s PDF and printing options.</p>
            <div class="access-integration-note">Available independently of an email connection.</div>
            <div class="access-integration-footer">
                <span>Built into your workspace</span>
                <a class="btn" asp-page="/Quotations/Index">View quotations</a>
            </div>
        </article>
    </div>
</div>
