@page "{kind}"
@model BuildWise.Web.Areas.Configuration.Pages.Access.IntegrationModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["AccountName"] = "Tawanda M.";
    ViewData["AccountRole"] = "Business owner";

    ViewData["PageTitle"] = Model.Title;
    ViewData["PageSubTitle"] = Model.IsAi ? "Choose the provider and preferences for drafting assistance." : "Prepare the sender details and sending service for quotation emails.";
    ViewData["Breadcrumbs"] = new BreadcrumbItem[]
    {
        new("Configuration"),
        new("Access & integrations", Url.Page("/Access/Index", new { area = "Configuration", id = (Guid?)null }))
    };
}

@section actionbar {
    <span class="badge">Not connected</span>
    <a class="btn" asp-page="/Access/Index">← Back to access &amp; integrations</a>
}

<div class="requests-page access-page">

    <div class="configuration-grid">
        <form method="post" class="panel request-detail-panel request-form access-form" asp-route-kind="@Model.Kind">
            <input type="hidden" asp-for="Input.Version" />
            <h2>@(Model.IsAi ? "AI preferences" : "Email preferences")</h2>
            <div asp-validation-summary="All" class="request-validation" role="alert"></div>

            @if (Model.IsAi)
            {
                <div class="field">
                    <label asp-for="Input.Provider">Provider <span>*</span></label>
                    <select asp-for="Input.Provider">
                        <option>OpenAI</option>
                        <option>Azure OpenAI</option>
                    </select>
                    <span asp-validation-for="Input.Provider"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Model">Model or deployment name <span>*</span></label>
                    <input asp-for="Input.Model" required maxlength="100" placeholder="Model or deployment configured for your business" />
                    <span asp-validation-for="Input.Model"></span>
                </div>
            }
            else
            {
                <div class="field">
                    <label asp-for="Input.Provider">Sending service <span>*</span></label>
                    <select asp-for="Input.Provider" id="email-provider">
                        <option>SMTP</option>
                        <option>Microsoft 365</option>
                    </select>
                    <span asp-validation-for="Input.Provider"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.SenderName">Sender name <span>*</span></label>
                    <input asp-for="Input.SenderName" required maxlength="100" autocomplete="organization" />
                    <span asp-validation-for="Input.SenderName"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.SenderEmail">Sender email <span>*</span></label>
                    <input asp-for="Input.SenderEmail" type="email" required maxlength="256" autocomplete="email" />
                    <span asp-validation-for="Input.SenderEmail"></span>
                </div>
                <fieldset id="smtp-settings" class="access-smtp-settings">
                    <legend>SMTP server</legend>
                    <div class="field">
                        <label asp-for="Input.Host">Server hostname</label>
                        <input asp-for="Input.Host" maxlength="253" placeholder="smtp.your-provider.com" />
                        <span asp-validation-for="Input.Host"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Input.Port">Port</label>
                        <input asp-for="Input.Port" type="number" min="1" max="65535" />
                        <span asp-validation-for="Input.Port"></span>
                    </div>
                    <label class="access-checkbox">
                        <input asp-for="Input.UseTls" />
                        <span><strong>Use TLS encryption</strong><small>Use an encrypted connection to the sending service.</small></span>
                    </label>
                </fieldset>
            }

            <label class="access-checkbox access-enable-preference">
                <input asp-for="Input.EnableWhenConnected" />
                <span><strong>@(Model.IsAi ? "Allow assistance when connected" : "Allow email delivery when connected")</strong><small>This preference takes effect after the connection is verified.</small></span>
            </label>

            <div class="request-form-actions">
                <button class="btn primary" type="submit">Save preferences</button>
                <a class="btn" asp-page="/Access/Index">Cancel</a>
            </div>
        </form>

        <aside class="configuration-column">
            <section class="request-workflow-note request-form-help">
                @await Html.PartialAsync("_WorkspaceIcon", "integration")
                <div>
                    <h2>Connection setup</h2>
                    <p>Saving preferences does not verify a connection. Credentials and a successful connection check are required before this tool can be used.</p>
                </div>
            </section>
            <section class="panel request-detail-panel access-guidance">
                <h2>@(Model.IsAi ? "You make the final decision." : "Review before sending.")</h2>
                <p>@(Model.IsAi ? "Assistance should use your service catalogue, keep unknown details visible and leave scope and quotation approval to your team." : "Check the customer’s recipient address and the exact quotation revision before requesting delivery. Saving these preferences sends no email.")</p>
                <a class="btn" asp-area="@(Model.IsAi ? "Services" : "Quotations")" asp-page="/Index">@(Model.IsAi ? "View service catalogue" : "View quotations")</a>
            </section>
        </aside>
    </div>
</div>

@section Scripts {
    <script src="~/js/integration-settings.js" asp-append-version="true"></script>
}
