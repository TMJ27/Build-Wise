@page
@model BuildWise.Web.Areas.Customers.Pages.IndexModel
@{
    ViewData["Title"] = "Customers";
    ViewData["PageTitle"] = ViewData["Title"];
    ViewData["PageSubTitle"] = "Manage your customer contact details and client types.";
}

@section actionbar {
        <a class="btn primary" asp-area="Customers" asp-page="/Upsert">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            <span>Add customer</span>
        </a>
}

<div class="requests-page customers-page">
    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="request-success" role="status">@message</div>
    }

    <div class="request-summary" aria-label="Customer summary">
        <a class="request-summary-card" asp-page="Index">
            <span class="summary-icon">
                <i class="fa-solid fa-users" aria-hidden="true"></i>
            </span>
            <span>
                <span class="summary-label">Total customers</span>
                <strong>@Model.TotalCount.ToString("D2")</strong>
            </span>
        </a>
        <div class="request-summary-card">
            <span class="summary-icon">
                <i class="fa-solid fa-file-lines" aria-hidden="true"></i>
            </span>
            <span>
                <span class="summary-label">With open requests</span>
                <strong>@Model.OpenCount.ToString("D2")</strong>
            </span>
        </div>
        <a class="request-summary-card" asp-page="Index" asp-route-type="@((int)ClientType.Business)">
            <span class="summary-icon">
                <i class="fa-solid fa-building" aria-hidden="true"></i>
            </span>
            <span>
                <span class="summary-label">Businesses</span>
                <strong>@Model.BusinessCount.ToString("D2")</strong>
            </span>
        </a>
        <a class="request-summary-card" asp-page="Index" asp-route-type="@((int)ClientType.Individual)">
            <span class="summary-icon">
                <i class="fa-solid fa-user" aria-hidden="true"></i>
            </span>
            <span>
                <span class="summary-label">Individuals</span>
                <strong>@Model.IndividualsCount.ToString("D2")</strong>
            </span>
        </a>
    </div>

    <section class="panel requests-panel">
        <div class="requests-panel-heading">
            <div>
                <h2>Customer register</h2>
                <p>@Model.ClientList.Count @(Model.ClientList.Count == 1 ? "customer" : "customers") shown</p>
            </div>
        </div>

        <form method="get" class="form-filters" role="search">
            <label class="form-search">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <span class="sr-only">Search customers</span>
                <input class="form-control" asp-for="Search" type="search" maxlength="120" placeholder="Search name, email, phone or address..." />
            </label>
            <label class="form-filter">
                <span>Client type</span>
                <select class="form-control" asp-for="Type" asp-items="Html.GetEnumSelectList<ClientType>()">
                    <option value="all">All types</option>
                </select>
            </label>
            <label class="form-filter">
                <span>Sort by</span>
                <select class="form-control" asp-for="Sort">
                    <option value="name">Name</option>
                    <option value="newest">Newest first</option>
                    <option value="oldest">Oldest first</option>
                </select>
            </label>
            <button class="btn" type="submit">Apply filters</button>
            @if (Model.Search.Length > 0 || Model.Type != "all" || Model.Sort != "name")
            {
                <a class="request-clear" asp-page="Index">Clear filters</a>
            }
        </form>

        <div class="table-wrap">
            <table class="configuration-table">
                <caption class="sr-only">Customers matching the selected filters</caption>
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Name</th>
                        <th scope="col">Client type</th>
                        <th scope="col">Email</th>
                        <th scope="col">Phone</th>
                        <th scope="col">Status</th>
                        <th scope="col">Creation date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model.ClientList)
                    {
                        var detailsUrl = Url.Page("/Details", new { area = "Customers", id = client.Id });
                        <tr>
                            <td>
                                @if (detailsUrl is not null)
                                {
                                    <a class="record-link record-id" href="@detailsUrl">
                                        @client.ClientNumber
                                        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="record-id">@client.ClientNumber</span>
                                }
                            </td>
                            <td>@client.Name</td>
                            <td>@(Enum.IsDefined(typeof(ClientType), client.ClientTypeId) ? ((ClientType)client.ClientTypeId).ToString() : "Not set")</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(client.Email))
                                {
                                    <a href="mailto:@client.Email">@client.Email</a>
                                }
                                else
                                {
                                    <span>Not provided</span>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(client.Phone) ? "Not provided" : client.Phone)</td>
                            <td>
                                <span class="badge @(client.IsActive ? "green" : null)">@(client.IsActive ? ActiveStatus.Active : ActiveStatus.Inactive)</span>
                            </td>
                            <td>@client.CreationDate.ToString("dd MMM yyyy, HH:mm")</td>
                        </tr>
                    }
                    @if (Model.ClientList.Count == 0)
                    {
                        <tr>
                            <td colspan="7">@(Model.TotalCount == 0 ? "No customers have been added." : "No customers match the selected filters.")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="requests-table-footer">
            <span>@Model.ClientList.Count of @Model.FilteredCount customers shown</span>
            @if (Model.PageCount > 1)
            {
                <nav class="request-pagination" aria-label="Customer pages">
                    @if (Model.PageNumber > 1)
                    {
                        <a class="btn" asp-page="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-sort="@Model.Sort">Previous</a>
                    }
                    <span>Page @Model.PageNumber of @Model.PageCount</span>
                    @if (Model.PageNumber < Model.PageCount)
                    {
                        <a class="btn" asp-page="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-sort="@Model.Sort">Next</a>
                    }
                </nav>
            }
        </div>
    </section>
</div>

