@page "/Overview"
@model IndexModel
@{
    ViewData["Title"] = "Overview";
    ViewData["PageTitle"] = "Overview";
    ViewData["PageSubTitle"] = "Requests, quotations and work needing your attention.";
    ViewData["NativeDashboard"] = true;
    ViewData["HideBreadcrumbs"] = true;

    ViewData["DashboardChartData"] = new
    {
        days = Model.Days.Select(day => new
        {
            label = IndexModel.Date(day.Date, "ddd"),
            date = IndexModel.Date(day.Date),
            prepared = day.Prepared,
            approved = day.Approved
        }),
        categories = Model.ChartCategories.Select(category => new
        {
            name = category.Name,
            count = category.Count,
            colour = category.Colour
        })
    };
}

@section actionbar {
    <form method="get" asp-page="/Index" class="form-inline" data-dashboard-range-form>
        <input type="hidden" name="Tab" value="@Model.Tab" />
        <label class="form-search">
            <i class="icon fa-solid fa-clock" aria-hidden="true"></i>
            <select class="form-control" asp-for="Range" aria-label="Dashboard date range">
                <option value="7">Last 7 days</option>
                <option value="30">Last 30 days</option>
                <option value="all">All time</option>
            </select>
        </label>
        <button class="btn" type="submit">Apply</button>
    </form>
    <a class="btn primary" asp-area="Requests" asp-page="/Create">
        <i class="icon fa-solid fa-plus" aria-hidden="true"></i>
        <span>New request</span>
    </a>
}

<div class="dashboard-page">
    <div class="request-summary" aria-label="Dashboard summary">
        <div class="request-summary-card">
            <span class="summary-icon">
                <i class="icon fa-solid fa-file-lines" aria-hidden="true"></i>
            </span>
            <span>
                <span class="summary-label">Open requests</span>
                <strong>@Model.OpenRequests.ToString("D2")</strong>
            </span>
        </div>

        <div class="request-summary-card">
            <span class="summary-icon">
                <i class="icon fa-solid fa-pen" aria-hidden="true"></i>
            </span>
            <span>
                <span class="summary-label">Draft quotations</span>
                <strong>@Model.DraftCount.ToString("D2")</strong>
            </span>
        </div>

        <div class="request-summary-card">
            <span class="summary-icon">
                <i class="icon fa-solid fa-check" aria-hidden="true"></i>
            </span>
            <span>
                <span class="summary-label">Approved quotations</span>
                <strong>@Model.ApprovedCount.ToString("D2")</strong>
            </span>
        </div>

        <div class="request-summary-card">
            <span class="summary-icon">
                <i class="icon fa-solid fa-users" aria-hidden="true"></i>
            </span>
            <span>
                <span class="summary-label">All customers</span>
                <strong>@Model.CustomerCount.ToString("D2")</strong>
            </span>
        </div>
    </div>
    <div class="db-analytics">
        <section class="panel">
            <div class="panel-head">
                <div>
                    <h2>Quotation activity</h2>
                    <p>Revisions prepared and approved over the last 7 days.</p>
                </div>
                <span class="badge">@Model.Quotations.Count in selected period</span>
            </div>
            <div class="panel-body">
                <div class="dashboard-chart-frame">
                    <canvas id="quotation-activity-chart" role="img" aria-label="Prepared and approved quotations over the last seven days" aria-describedby="quotation-chart-data">
                        Daily quotation totals are listed below.
                    </canvas>
                </div>
                <table id="quotation-chart-data" class="sr-only">
                    <caption>Daily quotation counts</caption>
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Prepared</th>
                            <th scope="col">Approved</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in Model.Days)
                        {
                            <tr>
                                <th scope="row">@IndexModel.Date(day.Date)</th>
                                <td>@day.Prepared</td>
                                <td>@day.Approved</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="dashboard-chart-summary">
                    <span>Approved value</span>
                    <strong>@Model.ApprovedValueText</strong>
                </div>
            </div>
        </section>

        <section class="panel">
            <div class="panel-head">
                <div>
                    <h2>Requests by service</h2>
                    <p>One count per request. Requests covering several categories are grouped together.</p>
                </div>
                <span class="badge">@Model.Requests.Count requests</span>
            </div>
            <div class="panel-body">
                @if (Model.Categories.Count == 0)
                {
                    <p class="db-empty">No requests in this period.</p>
                }
                else
                {
                    <div class="dashboard-chart-frame dashboard-chart-frame-doughnut">
                        <canvas id="requests-service-chart" role="img" aria-label="Request totals by service category" aria-describedby="requests-service-legend">
                            Category totals are listed below.
                        </canvas>
                    </div>
                    <ul class="dashboard-chart-legend" id="requests-service-legend">
                        @foreach (var category in Model.ChartCategories)
                        {
                            <li>
                                <span class="dashboard-legend-dot @category.ColourClass" aria-hidden="true"></span>
                                <span>@category.Name</span>
                                <strong>@category.Count</strong>
                            </li>
                        }
                    </ul>
                    <div class="dashboard-chart-summary">
                        <span>
                            @if (Model.Categories.Count > 5)
                            {
                                <text>Other includes @(Model.Categories.Count - 5) categories</text>
                            }
                            else
                            {
                                <text>@Model.Categories.Count categories</text>
                            }
                        </span>
                        <a class="text-link" asp-area="Requests" asp-page="/Index">
                            View all requests
                            <i class="icon fa-solid fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    </div>
                }
            </div>
        </section>
    </div>

    <div class="v2-lower">
        <div>
            <section class="panel" data-dashboard-table>
                <div class="panel-head">
                    <nav class="db-tabs" aria-label="Recent record type">
                        <a asp-page="/Index" asp-route-range="@Model.Range" asp-route-tab="requests"
                           data-records-tab="requests"
                           class="@(Model.Tab == "requests" ? "active" : null)"
                           aria-current="@(Model.Tab == "requests" ? "page" : null)">
                            Recent requests <span>@Model.VisibleRequests.Count</span>
                        </a>
                        <a asp-page="/Index" asp-route-range="@Model.Range" asp-route-tab="quotations"
                           data-records-tab="quotations"
                           class="@(Model.Tab == "quotations" ? "active" : null)"
                           aria-current="@(Model.Tab == "quotations" ? "page" : null)">
                            Quotations <span>@Model.VisibleQuotations.Count</span>
                        </a>
                    </nav>
                    <a class="text-link" href="@Model.ScreenUrl(Model.Tab == "requests" ? "requests" : "quotations")"
                       data-records-view-all aria-label="View all @Model.Tab">
                        View all
                        <i class="icon fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
                <p class="request-validation" role="alert" data-records-error hidden></p>
                <div id="dashboard-records-region" aria-live="polite" aria-busy="false">
                    @await Html.PartialAsync("_DashboardRecords", Model)
                </div>
            </section>

        </div>

        <aside>
            <section class="panel dashboard-attention">
                <div class="panel-head">
                    <div>
                        <h2>Needs attention</h2>
                        <p>Requests waiting for your next step.</p>
                    </div>
                    <span class="badge">@Model.Attention.Count</span>
                </div>
                <div class="panel-body">
                    @foreach (var item in Model.Attention)
                    {
                        <a class="attention-item" href="@Model.ScreenUrl($"{item.Route}/{item.Request.Id}")">
                            <span class="square @item.Tone">
                                @if (item.Route == "clarify")
                                {
                                    <i class="icon fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                                }
                                else if (item.Route == "scope")
                                {
                                    <i class="icon fa-solid fa-list-check" aria-hidden="true"></i>
                                }
                                else
                                {
                                    <i class="icon fa-solid fa-file-invoice-dollar" aria-hidden="true"></i>
                                }
                            </span>
                            <div>
                                <h3>@item.Title</h3>
                                <p>@item.Request.Customer · @item.Request.Title</p>
                            </div>
                            <i class="icon fa-solid fa-chevron-right db-next" aria-hidden="true"></i>
                        </a>
                    }
                    @if (Model.Attention.Count == 0)
                    {
                        <p class="db-empty">No pending actions in this period.</p>
                    }
                </div>
            </section>
        </aside>
    </div>

</div>

<template id="dashboard-notifications">
    <h2>Workspace activity</h2>
    @foreach (var activity in Model.Activity)
    {
        <a class="activity" href="@Model.ScreenUrl(activity.Route)">
            <span class="avatar">
                @if (activity.Title == "Quotation approved")
                {
                    <i class="icon fa-solid fa-check" aria-hidden="true"></i>
                }
                else if (activity.Title == "Quotation prepared")
                {
                    <i class="icon fa-solid fa-pen" aria-hidden="true"></i>
                }
                else
                {
                    <i class="icon fa-solid fa-file-lines" aria-hidden="true"></i>
                }
            </span>
            <div>
                <p>
                    <b>@activity.Title</b><br />
                    @activity.Detail
                </p>
                <small>@IndexModel.Date(activity.Date, "d MMM")</small>
            </div>
        </a>
    }
    <div class="actions workspace-dialog-actions">
        <button type="button" class="btn" data-workspace-dialog-close>Close</button>
    </div>
</template>
