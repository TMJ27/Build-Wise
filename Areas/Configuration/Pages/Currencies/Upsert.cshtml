@page "{id:guid?}"
@model BuildWise.Web.Areas.Configuration.Pages.Currencies.UpsertModel
@{
    var editing = Model.Input.Id.HasValue;
    ViewData["Title"] = editing ? "Edit currency" : "Add currency";
    ViewData["PageTitle"] = ViewData["Title"];
    ViewData["PageSubTitle"] = editing
        ? "Update the currency name, code and symbol."
        : "Enter the currency name, code and symbol.";
    ViewData["Breadcrumbs"] = new BreadcrumbItem[]
    {
        new("Configuration"),
        new("Currencies", Url.Page("/Currencies/Index", new { area = "Configuration", id = (Guid?)null }))
    };
}

<div class="requests-page configuration-page">
    <form method="post" class="form-stack">
        <input type="hidden" asp-for="Input.Id" />
        <div asp-validation-summary="All" class="configuration-errors" role="alert"></div>

        <section class="panel configuration-section form-panel">
            <div class="configuration-section-title">
                <span class="summary-icon">
                    <i class="fa-solid fa-coins" aria-hidden="true"></i>
                </span>
                <div>
                    <h2>Currency details</h2>
                    <p>Fields marked with * are required.</p>
                </div>
            </div>

            <div class="form-fields">
                <div class="field">
                    <label asp-for="Input.Name">Name <span>*</span></label>
                    <input class="form-control" asp-for="Input.Name" required maxlength="80" />
                    <span asp-validation-for="Input.Name"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Code">Code <span>*</span></label>
                    <input class="form-control" asp-for="Input.Code" required maxlength="3" aria-describedby="currency-code-help" />
                    <span asp-validation-for="Input.Code"></span>
                    <p id="currency-code-help" class="configuration-muted">Enter a three-letter code, such as USD.</p>
                </div>
                <div class="field">
                    <label asp-for="Input.Symbol">Symbol <span>*</span></label>
                    <input class="form-control" asp-for="Input.Symbol" required maxlength="10" />
                    <span asp-validation-for="Input.Symbol"></span>
                </div>
            </div>
        </section>

        <div class="form-actions">
            <button class="btn primary" type="submit">
                <i class="fa-solid fa-check" aria-hidden="true"></i>
                <span>@(editing ? "Save changes" : "Create currency")</span>
            </button>
        </div>
    </form>
</div>



