@page
@model BuildWise.Web.Areas.CustomerPortal.Pages.Account.ForgotPasswordModel
@{
    Layout = "/Pages/Shared/_CustomerPublicLayout.cshtml";
    ViewData["Title"] = "Forgot password";
    ViewData["CustomerAuth"] = true;
}
<section aria-labelledby="recovery-title">
    <p class="eyebrow">ACCOUNT RECOVERY</p>
    <h2 id="recovery-title">Forgot your password?</h2>
    @if (Model.Submitted)
    {
        <div class="auth-alert auth-alert-success" role="status">If an active account matches that email, you will receive a password reset link. Check your inbox and spam folder.</div>
    }
    else
    {
        <p class="auth-description">Enter your account email to request a password reset link.</p>
        <form method="post" class="auth-form">
            <div asp-validation-summary="All" class="auth-alert" role="alert"></div>
            <div class="auth-field">
                <label asp-for="Input.Email">Email address <span>*</span></label>
                <input asp-for="Input.Email" type="email" autocomplete="username" maxlength="50" required />
                <span class="field-error" asp-validation-for="Input.Email"></span>
            </div>
            <button class="auth-button" type="submit"><span>Send reset link</span></button>
        </form>
    }
    <p class="auth-footnote"><a asp-page="Login">Return to sign in</a></p>
</section>
