@page "{id:guid}"
@model BuildWise.Web.Pages.Services.DetailsModel
@{
    ViewData["Title"] = Model.Service.Name;
    ViewData["ActiveSection"] = "catalogue";
    ViewData["AccountName"] = "Tawanda M.";
    ViewData["AccountRole"] = "Business owner";
}

@section Styles {
    <link rel="stylesheet" href="~/css/requests.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalogue.css" asp-append-version="true" />
}

<div class="requests-page catalogue-page">
    <a class="request-back" asp-page="Index">← Back to catalogue</a>

    @if (TempData["CatalogueMessage"] is string message)
    {
        <div class="request-success" role="status">
            @await Html.PartialAsync("_WorkspaceIcon", "check")
            @message
        </div>
    }

    <header class="requests-heading">
        <div>
            <div class="eyebrow">@Model.Service.Code · @Model.Service.Category</div>
            <h1>@Model.Service.Name</h1>
            <p>Reusable details that bring clarity to each customer request.</p>
        </div>
        <div class="catalogue-actions">
            <a class="btn" asp-page="Edit" asp-route-id="@Model.Service.Id">
                @await Html.PartialAsync("_WorkspaceIcon", "edit")
                <span>Edit service</span>
            </a>
            @if (Model.Service.IsActive)
            {
                <a class="btn primary" asp-page="/Requests/Create" asp-route-serviceId="@Model.Service.Id">
                    @await Html.PartialAsync("_WorkspaceIcon", "plus")
                    <span>Start request</span>
                </a>
            }
        </div>
    </header>

    <div class="catalogue-detail-grid">
        <div class="catalogue-column">
            <section class="panel request-detail-panel">
                <div class="catalogue-section-heading">
                    <h2>Service overview</h2>
                    <span class="badge @(Model.Service.IsActive ? "green" : "")">@(Model.Service.IsActive ? "Active" : "Archived")</span>
                </div>
                <p class="catalogue-copy">@Model.Service.Description</p>
                <dl>
                    <div><dt>Category</dt><dd>@Model.Service.Category</dd></div>
                    <div><dt>Measurement unit</dt><dd>@Model.Service.Unit</dd></div>
                    <div><dt>Site assessment</dt><dd>@(Model.Service.RequiresSiteAssessment ? "Required before confirming the scope" : "Confirm for each request")</dd></div>
                </dl>
            </section>

            <section class="panel request-detail-panel">
                <div class="catalogue-scope-columns">
                    <div>
                        <h2>What’s included</h2>
                        <ul class="catalogue-list">
                            @foreach (var item in Model.Service.Inclusions)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    </div>
                    <div>
                        <h2>What’s excluded</h2>
                        <ul class="catalogue-list">
                            @foreach (var item in Model.Service.Exclusions)
                            {
                                <li>@item</li>
                            }
                        </ul>
                        @if (Model.Service.Exclusions.Count == 0)
                        {
                            <p class="catalogue-muted">No default exclusions recorded.</p>
                        }
                    </div>
                </div>
            </section>

            <section class="panel request-detail-panel">
                <div class="catalogue-section-heading">
                    <div><h2>Clarification questions</h2><p>Information to confirm with the customer.</p></div>
                    <span class="badge">@Model.Service.Questions.Count questions</span>
                </div>
                <ol class="catalogue-numbered-list">
                    @foreach (var question in Model.Service.Questions)
                    {
                        <li>@question</li>
                    }
                </ol>
                @if (Model.Service.Questions.Count == 0)
                {
                    <p class="catalogue-muted">No default questions recorded.</p>
                }
            </section>

            <section class="panel request-detail-panel">
                <h2>Normal work stages</h2>
                <p class="catalogue-muted">Use this sequence as a starting point when reviewing the scope.</p>
                <ol class="catalogue-numbered-list catalogue-stage-list">
                    @foreach (var stage in Model.Service.Stages)
                    {
                        <li>@stage</li>
                    }
                </ol>
            </section>
        </div>

        <aside class="catalogue-column">
            <section class="request-workflow-note request-form-help">
                @await Html.PartialAsync("_WorkspaceIcon", "help")
                <div>
                    <h2>A catalogue you can stand behind.</h2>
                    <p>These details provide a starting point. Review the actual site, quantities and customer requirements before approving a quotation.</p>
                </div>
            </section>

            <section class="panel request-detail-panel">
                <h2>Service dependencies</h2>
                <p class="catalogue-muted">Work that should happen before this service.</p>
                @foreach (var dependency in Model.Dependencies)
                {
                    <a class="catalogue-dependency" asp-page="Details" asp-route-id="@dependency.Id">
                        <span><strong>@dependency.Name</strong><small>@dependency.Code · @(dependency.IsActive ? "Active" : "Archived")</small></span>
                        @await Html.PartialAsync("_WorkspaceIcon", "chevron")
                    </a>
                }
                @if (Model.Dependencies.Count == 0)
                {
                    <p class="catalogue-muted">No default dependencies recorded.</p>
                }
            </section>

            <section class="panel request-detail-panel">
                <h2>Service availability</h2>
                <p class="catalogue-muted">@(Model.Service.IsActive ? "Archive this service when it is no longer offered. Its definition will remain available for reference." : "Activate this service to offer it for new customer requests.")</p>
                <form method="post" asp-page-handler="Toggle" asp-route-id="@Model.Service.Id" class="catalogue-availability-form">
                    <button class="btn" type="submit">@(Model.Service.IsActive ? "Archive service" : "Activate service")</button>
                </form>
            </section>
        </aside>
    </div>
</div>
