@page "{id:int}"
@model BuildWise.Web.Areas.Requests.Pages.DetailsModel
@{
    ViewData["Title"] = Model.Entry.Request.Title;
    ViewData["AccountName"] = "Tawanda M.";
    ViewData["AccountRole"] = "Business owner";
    var request = Model.Entry.Request;

    ViewData["PageTitle"] = request.Title;
    ViewData["PageSubTitle"] = $"Created {request.CreatedOn:dd MMM yyyy}";
    ViewData["Breadcrumbs"] = new BreadcrumbItem[]
    {
        new("Requests", Url.Page("/Index", new { area = "Requests" }))
    };
}

@section actionbar {
    <span class="badge @request.BadgeClass">@request.Status</span>
    <a class="btn" asp-page="Index">← Back to requests</a>
}
<div class="requests-page">

    @if (TempData["RequestCreated"] is string message) { <div class="request-success" role="status">@await Html.PartialAsync("_WorkspaceIcon", "check")@message</div> }

    @if (Model.Quotation is not null)
    {
        <div>
            <a class="btn" asp-area="Quotations" asp-page="/Details" asp-route-id="@Model.Quotation.Quotation.Id">
                @await Html.PartialAsync("_WorkspaceIcon", "quote")
                <span>View quotation @Model.Quotation.Number</span>
            </a>
        </div>
    }
    else if (request.Status == "Ready to quote")
    {
        <div>
            <a class="btn primary" asp-area="Quotations" asp-page="/Edit" asp-route-requestId="@request.Id">
                @await Html.PartialAsync("_WorkspaceIcon", "plus")
                <span>Create quotation</span>
            </a>
        </div>
    }
    <div class="request-detail-grid">
        <section class="panel request-detail-panel"><h2>The customer’s request</h2><p class="request-description">@Model.Entry.Description</p><dl><div><dt>Service category</dt><dd>@request.Category</dd></div><div><dt>Site location</dt><dd>@Model.Entry.Location</dd></div><div><dt>Current stage</dt><dd>@request.Status</dd></div></dl></section>
        <aside class="panel request-detail-panel">
            <span class="summary-icon">@await Html.PartialAsync("_WorkspaceIcon", "users")</span>
            <h2>
                <a asp-area="Customers" asp-page="/Details" asp-route-id="@Model.Entry.CustomerId">@request.Customer</a>
            </h2>
            <p>Customer</p>
            @if (!string.IsNullOrWhiteSpace(Model.Entry.Email))
            {
                <p><a href="mailto:@Model.Entry.Email">@Model.Entry.Email</a></p>
            }
            <hr />
            <h3>Before preparing the scope</h3>
            <p>Confirm the site conditions, measurements, material preferences and any exclusions with the customer.</p>
        </aside>
    </div>
</div>
