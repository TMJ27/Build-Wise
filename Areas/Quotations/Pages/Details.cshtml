@page "{id:guid}"
@model BuildWise.Web.Areas.Quotations.Pages.DetailsModel
@using BuildWise.Lib.Enums.Statuses
@{
    var document = Model.Document;
    var revision = document.Revision;
    var status = (QuotationStatus)revision.StatusId;
    ViewData["Title"] = "Quotation details";
    ViewData["PageTitle"] = document.Number;
    ViewData["PageSubTitle"] = revision.Title;
    ViewData["Breadcrumbs"] = new BreadcrumbItem[]
    {
        new("Quotations", Url.Page("/Index", new { area = "Quotations", id = (Guid?)null }))
    };
}

@section actionbar {
    @if (status == QuotationStatus.Approved && revision.ApprovalDate.HasValue
        && document.Revisions.FirstOrDefault(item => item.StatusId == (int)QuotationStatus.Approved)?.Id == revision.Id)
    {
        <a class="btn primary" asp-page="Send" asp-route-id="@document.Id" asp-route-revisionId="@revision.Id">
            <i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Send quotation
        </a>
    }
    @if (document.IsLatest && status != QuotationStatus.Cancelled)
    {
        <a class="btn edit" asp-page="Upsert" asp-route-id="@document.Id">
            <i class="fa-solid fa-pen" aria-hidden="true"></i>
            <span>@(status == QuotationStatus.Approved ? "Create revision" : "Edit draft")</span>
        </a>
    }
    <a class="btn secondary" asp-page="Preview" asp-route-id="@document.Id" asp-route-revisionId="@revision.Id">
        <i class="fa-solid fa-file-lines" aria-hidden="true"></i>
        <span>Preview quotation</span>
    </a>
}

<div class="requests-page quotations-page">
    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="request-success" role="status">@message</div>
    }
    <div asp-validation-summary="All" class="configuration-errors" role="alert"></div>
    <div class="details-stack">
        @if (status == QuotationStatus.Approved || Model.CustomerResponse is not null)
        {
            <section class="panel detail-card">
                <header class="card-header card-header-between">
                    <h2>Customer response</h2>
                    @if (Model.CustomerResponse is { } response)
                    { <span class="badge @(response.StatusId == (int)QuotationResponseStatus.Accepted ? "green" : "amber")">@((QuotationResponseStatus)response.StatusId)</span> }
                </header>
                <div class="card-body">
                    @if (Model.CustomerResponse is { } saved)
                    {
                        <dl class="profile-detail-list">
                            <div><dt>Customer</dt><dd>@saved.CustomerNameSnapshot</dd></div>
                            <div><dt>Email</dt><dd><a href="mailto:@saved.CustomerEmailSnapshot">@saved.CustomerEmailSnapshot</a></dd></div>
                            @if (!string.IsNullOrWhiteSpace(saved.Reason))
                            { <div class="profile-detail-wide"><dt>Reason for declining</dt><dd>@saved.Reason</dd></div> }
                        </dl>
                    }
                    else
                    { <p>Awaiting customer response.</p> }
                </div>
                <footer class="card-footer">
                    <dl class="record-metadata">
                        <div><dt>Revision</dt><dd>@revision.RevisionNumber</dd></div>
                        @if (Model.CustomerResponse is { } audit)
                        { <div><dt>Responded</dt><dd>@audit.CreationDate.ToString("dd MMM yyyy, HH:mm")</dd></div> }
                    </dl>
                </footer>
            </section>
        }
        <section class="detail-card panel configuration-section">
            <header class="card-header card-header-between">
                <h2>Quotation details</h2>
                <span class="badge @(status == QuotationStatus.Approved ? "green" : null)">@status · Revision @revision.RevisionNumber</span>
            </header>
            <div class="card-body">
                <dl class="profile-detail-list">
                    <div><dt>Customer</dt><dd>@revision.CustomerNameSnapshot</dd></div>
                    <div><dt>Request</dt><dd>@(document.RequestReference ?? "Not assigned")</dd></div>
                    <div><dt>Issue date</dt><dd>@(revision.IssueDate?.ToString("dd MMM yyyy") ?? "Not set")</dd></div>
                    <div><dt>Valid until</dt><dd>@(revision.ValidUntil?.ToString("dd MMM yyyy") ?? "Not set")</dd></div>
                    <div class="profile-detail-wide"><dt>Site address</dt><dd>@revision.SiteAddressSnapshot</dd></div>
                    <div class="profile-detail-wide"><dt>Terms</dt><dd>@(revision.Terms ?? "Not provided")</dd></div>
                    <div class="profile-detail-wide"><dt>Assumptions and exclusions</dt><dd>@(revision.Exclusions ?? "Not provided")</dd></div>
                </dl>
            </div>
            <footer class="card-footer">
                <dl class="record-metadata">
                    <div><dt>Creator</dt><dd>@(revision.Creator.Name ?? revision.Creator.Email)</dd></div>
                    <div><dt>Created</dt><dd>@revision.CreationDate.ToString("dd MMM yyyy, HH:mm")</dd></div>
                    @if (revision.ApprovalDate.HasValue)
                    {
                        <div><dt>Approved by</dt><dd>@(revision.ApprovedByUser?.Name ?? revision.ApprovedByUser?.Email ?? "Not set")</dd></div>
                        <div><dt>Approved</dt><dd>@revision.ApprovalDate.Value.ToString("dd MMM yyyy, HH:mm")</dd></div>
                    }
                </dl>
            </footer>
        </section>
        <section class="detail-card panel configuration-section">
            <header class="card-header"><h2>Quoted services</h2></header>
            <div class="card-body">
                @await Html.PartialAsync("_QuotationRevisionItems", revision)
            </div>
            <footer class="card-footer"><span>@revision.QuotationItems.Count services · @(revision.IncludesPrices ? revision.CurrencyCode : "Without prices")</span></footer>
        </section>
        @if (document.IsLatest && status == QuotationStatus.Draft)
        {
            <form method="post" asp-page-handler="Approve" asp-route-id="@document.Id" class="detail-card panel configuration-section">
                <input type="hidden" name="revisionId" value="@revision.Id" />
                <input type="hidden" name="version" value="@document.Version" />
                <header class="card-header"><h2>Approve quotation</h2></header>
                <div class="card-body">
                    <label class="form-check">
                        <input type="checkbox" name="confirm" value="true" required />
                        <span>I have reviewed the work, amounts and terms for this revision.</span>
                    </label>
                </div>
                <footer class="card-footer form-card-footer">
                    <button class="btn primary" type="submit"><i class="fa-solid fa-check" aria-hidden="true"></i><span>Approve quotation</span></button>
                </footer>
            </form>
        }
        <section class="detail-card panel configuration-section">
            <header class="card-header"><h2>Revision history</h2></header>
            <div class="card-body table-wrap">
                <table class="configuration-table">
                    <thead><tr><th scope="col">Revision</th><th scope="col">Status</th><th scope="col">Created</th></tr></thead>
                    <tbody>
                        @foreach (var entry in document.Revisions)
                        {
                            <tr>
                                <td><a class="record-link" asp-page="Details" asp-route-id="@document.Id" asp-route-revisionId="@entry.Id">Revision @entry.RevisionNumber <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a></td>
                                <td>@((QuotationStatus)entry.StatusId)</td>
                                <td>@entry.CreationDate.ToString("dd MMM yyyy, HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <footer class="card-footer"><span>@document.Revisions.Count revisions</span></footer>
        </section>
    </div>
</div>
