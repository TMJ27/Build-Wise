@using System.Text.Json
@{
    var title = ViewData["Title"]?.ToString() ?? "Workspace";


    var fullWidth = ViewData["UseFullWidthLayout"] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#14233b" />
    <title>@title · BuildWise</title>
    <link rel="icon" type="image/svg+xml" href="~/brand/buildwise-mark-muted.svg" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/fontawesome.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/solid.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="workspace-page" data-server-shell="@(!fullWidth ? "true" : "false")" data-native-dashboard="@(ViewData["NativeDashboard"] is true ? "true" : "false")">
    <a class="skip-link" href="#main-content">Skip to content</a>
    @if (fullWidth)
    {
        <main id="main-content" class="public-wrapper" tabindex="-1">@RenderBody()</main>
        IgnoreSection("actionbar");
    }
    else
    {
        @await Html.PartialAsync("_WorkspaceHeader")
        @await Html.PartialAsync("_Sidebar")
        <main class="v2-main" id="main-content" tabindex="-1">
            <div class="content">
                @await Html.PartialAsync("_Breadcrumbs")
                @if (ViewData["PageTitle"] is not null || IsSectionDefined("actionbar"))
                {
                    <header class="page-head @ViewData["PageHeaderClass"]">
                        <div class="page-heading-identity">
                            @if (ViewData["PageInitials"] is not null)
                            {
                                <span class="customer-avatar customer-avatar-large" aria-hidden="true">@ViewData["PageInitials"]</span>
                            }
                            <div>
                                @if (ViewData["PageTitle"] is not null)
                                {
                                    <h1>@ViewData["PageTitle"]</h1>
                                }
                                @if (ViewData["PageSubTitle"] is not null)
                                {
                                    <p>@ViewData["PageSubTitle"]</p>
                                }
                            </div>
                        </div>
                        @if (IsSectionDefined("actionbar"))
                        {
                            <div class="actions">
                                @await RenderSectionAsync("actionbar", required: false)
                            </div>
                        }
                    </header>
                }
                @RenderBody()
                <footer class="footer-note"><span>© @DateTime.Now.Year BuildWise · Built for the way you work.</span></footer>
            </div>
        </main>
    }
    <div id="toast" role="status" aria-live="polite"></div>
    <dialog id="modal" aria-label="Workspace dialog"><div id="modal-content"></div></dialog>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>
    <script src="~/js/workspace.js" asp-append-version="true"></script>
    <script src="~/js/business-profile.js" asp-append-version="true"></script>
    <script src="~/js/rights-selector.js" asp-append-version="true"></script>
    <script src="~/js/quotation-preview.js" asp-append-version="true"></script>
    @if (ViewData["DashboardChartData"] is { } chartData)
    {
        <script id="dashboard-chart-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(chartData))</script>
        <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
        <script src="~/js/dashboard-charts.js" asp-append-version="true"></script>
        <script src="~/js/dashboard-records.js" asp-append-version="true"></script>
    }
</body>
</html>
