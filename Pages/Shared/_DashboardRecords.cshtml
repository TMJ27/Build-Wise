@model BuildWise.Web.Pages.IndexModel
@using BuildWise.Web.Pages
<div class="table-period" data-view-all-url="@Model.ScreenUrl(Model.Tab == "requests" ? "requests" : "quotations")">
    <span>Last 7 days</span>
    <span>@Model.PeriodCaption</span>
</div>
<div class="table-wrap" id="dashboard-records">
    <table>
        <thead><tr>
                        <th scope="col">ID</th><th>@(Model.Tab == "requests" ? "Request / customer" : "Quotation / customer")</th><th>Status</th><th>@(Model.Tab == "requests" ? "Created" : "Value (USD)")</th></tr></thead>
        <tbody>
        @if (Model.Tab == "requests")
        {
            @foreach (var request in Model.VisibleRequests.Take(6))
            {
                <tr>
                    <td>
                        <a class="record-link record-id" href="@Model.ScreenUrl($"request/{request.Id}")">
                            @request.RequestNumber
                            <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                        </a>
                    </td>
                    <td>
                        <strong>@request.Title</strong>
                        <small>@request.Customer</small>
                    </td>
                    <td><span class="badge @request.BadgeClass">@request.Status</span></td><td class="muted">@IndexModel.Date(request.CreatedOn)</td>
                    </tr>
            }
            @if (Model.VisibleRequests.Count == 0) { <tr><td colspan="4" class="empty">No requests in the last 7 days.</td></tr> }
        }
        else
        {
            @foreach (var quotation in Model.VisibleQuotations.Take(6))
            {
                var request = Model.RequestFor(quotation.RequestId);
                <tr>
                    <td>
                        <a class="record-link record-id" href="@Model.ScreenUrl($"quote/{quotation.Id}")">
                            @quotation.QuotationNumber
                            <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                        </a>
                    </td>
                    <td>
                        <strong>@request.Title</strong>
                        <small>@request.Customer</small>
                    </td>
                    <td><span class="badge @(quotation.Status == "Approved" ? "green" : "")">@quotation.Status</span></td><td>@IndexModel.Money(quotation.Amount)</td>
                    </tr>
            }
            @if (Model.VisibleQuotations.Count == 0) { <tr><td colspan="4" class="empty">No quotations in the last 7 days.</td></tr> }
        }
        </tbody>
    </table>
</div>
<div class="table-foot">
    @if (Model.Tab == "requests")
    { <span>Showing @Math.Min(6, Model.VisibleRequests.Count) of @Model.VisibleRequests.Count requests</span> }
    else
    { <span>Showing @Math.Min(6, Model.VisibleQuotations.Count) of @Model.VisibleQuotations.Count quotations</span> }
</div>
