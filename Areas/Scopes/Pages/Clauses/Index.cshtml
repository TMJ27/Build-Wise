@page "{scopeItemId:guid}"
@model BuildWise.Web.Areas.Scopes.Pages.Clauses.IndexModel
@{
    ViewData["Title"] = "Scope clauses";
    ViewData["PageTitle"] = ViewData["Title"];
    ViewData["PageSubTitle"] = Model.ScopeItemTitle;
    ViewData["Breadcrumbs"] = new BreadcrumbItem[]
    {
        new("Scope", Url.Page("/Index", new { area = "Scopes", id = (Guid?)null, scopeItemId = (Guid?)null, requestId = (Guid?)null })),
        new("Request scope", Url.Page("/Details", new { area = "Scopes", id = Model.RequestId, scopeItemId = (Guid?)null, requestId = (Guid?)null })),
        new("Scope item", Url.Page("/Items/Details", new { area = "Scopes", id = Model.ScopeItemId, requestId = Model.RequestId, scopeItemId = (Guid?)null }))
    };
}

@section actionbar {
    @if (Model.CanEdit)
    {
        <a class="btn primary" asp-page="Upsert" asp-route-id="" asp-route-scopeItemId="@Model.ScopeItemId" asp-route-requestId="">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            <span>Add clause</span>
        </a>
    }
}

<div class="requests-page">
    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="request-success" role="status">@message</div>
    }
    <section class="panel configuration-section">
        <div class="configuration-preview-heading">
            <h2>Scope clauses</h2>
            <span class="badge">@Model.Clauses.Count clauses</span>
        </div>
        <div class="table-wrap">
            <table class="configuration-table">
                <caption class="sr-only">Inclusions, exclusions and conditions for @Model.ScopeItemTitle</caption>
                <thead>
                    <tr>
                        <th scope="col">Type</th>
                        <th scope="col">Wording</th>
                        <th scope="col">Creator</th>
                        <th scope="col">Creation date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var clause in Model.Clauses)
                    {
                        <tr>
                            <td>
                                <a class="record-link" asp-page="Details" asp-route-id="@clause.Id" asp-route-scopeItemId="@Model.ScopeItemId" asp-route-requestId="">
                                    @clause.ClauseTypeName
                                    <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                                </a>
                            </td>
                            <td>@clause.Description</td>
                            <td>@clause.CreatorName</td>
                            <td>@(clause.CreationDate?.ToString("dd MMM yyyy, HH:mm") ?? "Not set")</td>
                        </tr>
                    }
                    @if (Model.Clauses.Count == 0)
                    {
                        <tr><td colspan="4">No clauses have been added to this scope item.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
