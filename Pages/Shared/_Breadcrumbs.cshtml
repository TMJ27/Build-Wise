@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var isDashboard = currentArea == "" && currentPage == "/Index";
    var breadcrumbs = ViewData["Breadcrumbs"] as IEnumerable<BreadcrumbItem> ?? [];
    var currentTitle = ViewData["BreadcrumbTitle"]?.ToString()
        ?? ViewData["Title"]?.ToString()
        ?? "Workspace";
}

<nav class="workspace-breadcrumbs" aria-label="Breadcrumb">
    <ol>
        @if (!isDashboard)
        {
            <li><a asp-area="" asp-page="/Index">Overview</a></li>
        }
        @foreach (var item in breadcrumbs)
        {
            <li>
                @if (item.Url is not null && Url.IsLocalUrl(item.Url))
                {
                    <a href="@item.Url">@item.Title</a>
                }
                else
                {
                    <span>@item.Title</span>
                }
            </li>
        }
        <li aria-current="page">@currentTitle</li>
    </ol>
</nav>
