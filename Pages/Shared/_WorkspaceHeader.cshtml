@{
    var accountName = User.FindFirst("name")?.Value ?? User.Identity?.Name ?? ViewData["AccountName"]?.ToString() ?? "Your account";
    var accountRole = ViewData["AccountRole"]?.ToString() ?? "Workspace member";
    var initials = string.Concat(accountName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}
<header class="v2-header">
    <a class="brand" asp-page="/Index"><img src="~/brand/buildwise-mark-muted.svg" alt="" />BuildWise</a>
    <div class="v2-header-right">
        <button class="icon-btn notification" type="button" data-action="notifications" aria-label="Notifications">@await Html.PartialAsync("_WorkspaceIcon", "bell")</button>
        <span class="v2-divider" aria-hidden="true"></span>
        <span class="avatar" aria-hidden="true">@initials</span>
        <div class="v2-owner"><b style="font-size:11px">@accountName</b><small style="display:block;font-size:9px;margin-top:4px">@accountRole</small></div>
        <button class="icon-btn v2-mobile-menu" type="button" data-workspace-menu aria-controls="workspace-navigation" aria-expanded="false" aria-label="Open workspace navigation">@await Html.PartialAsync("_WorkspaceIcon", "menu")</button>
    </div>
</header>
