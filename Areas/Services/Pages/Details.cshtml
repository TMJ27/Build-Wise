@page "{id:guid}"
@model BuildWise.Web.Areas.Services.Pages.DetailsModel
@{
    var service = Model.ServiceDetails;
    ViewData["Title"] = "Service details";
    ViewData["PageTitle"] = service.Name;
    ViewData["PageSubTitle"] = "Service information, availability and creation record.";
    ViewData["BreadcrumbTitle"] = service.ServiceNumber;
    ViewData["Breadcrumbs"] = new BreadcrumbItem[]
    {
        new("Service catalogue", Url.Page("/Index", new { area = "Services", id = (Guid?)null }))
    };
}

@section actionbar {
    <a class="btn primary" asp-page="Upsert" asp-route-id="@service.Id">
        <i class="fa-solid fa-pen" aria-hidden="true"></i>
        <span>Edit service</span>
    </a>
}

<div class="requests-page catalogue-page profile-details">
    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="request-success" role="status">
            @message
        </div>

    }

    <div class="details-stack">
        <section class="detail-card panel configuration-section">
            <header class="card-header">
                <h2>Service details</h2>
            </header>

            <div class="card-body">
                <dl class="profile-detail-list">
                    <div>
                        <dt>Service ID</dt>
                        <dd>@service.ServiceNumber</dd>
                    </div>
                    <div>
                        <dt>Name</dt>
                        <dd>@service.Name</dd>
                    </div>
                    <div>
                        <dt>Category</dt>
                        <dd>
                            <a asp-area="Configuration" asp-page="/ServiceCategories/Details" asp-route-id="@service.CategoryId">@service.CategoryName</a>
                            @if (!service.CategoryIsActive)
                            {
                                <span class="badge">@ActiveStatus.Inactive category</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>Site assessment</dt>
                        <dd>@(service.RequireSiteAssessment ? "Required" : "Not required")</dd>
                    </div>
                    <div>
                        <dt>Status</dt>
                        <dd>
                            <span class="badge @(service.IsActive ? "green" : null)">@service.Status</span>
                        </dd>
                    </div>
                    <div class="profile-detail-wide">
                        <dt>Description</dt>
                        <dd>@(string.IsNullOrWhiteSpace(service.Description) ? "Not provided" : service.Description)</dd>
                    </div>
                </dl>

            </div>
            <footer class="card-footer">
                <dl class="record-metadata">
                    <div>
                        <dt>Created by</dt>
                        <dd>@service.CreatorName</dd>
                    </div>
                    <div>
                        <dt>Creation date</dt>
                        <dd>@service.CreationDate.ToString("dd MMM yyyy, HH:mm")</dd>
                    </div>
                    <div>
                        <dt>Last updated</dt>
                        <dd>@(service.LastUpdated?.ToString("dd MMM yyyy, HH:mm") ?? "Not updated")</dd>
                    </div>
                </dl>

            </footer>

        </section>

        <div class="catalogue-column">
            <section class="detail-card panel configuration-section">
                <header class="card-header">
                    <h2>Service availability</h2>
                </header>

                <div class="card-body">
                    <p class="configuration-muted">
                        @(service.IsActive
                        ? "Deactivate this service when it is no longer offered. Existing records are retained."
                        : "Activate this service to make it available again.")
                    </p>
                </div>
                <footer class="card-footer">
                    <form method="post" asp-page-handler="Toggle" asp-route-id="@service.Id">
                        <button class="btn" type="submit">
                            <i class="fa-solid @(service.IsActive ? "fa-box-archive" : "fa-check")" aria-hidden="true"></i>
                            <span>@(service.IsActive ? "Deactivate service" : "Activate service")</span>
                        </button>
                    </form>

                </footer>

            </section>

        </div>
    </div>

</div>
