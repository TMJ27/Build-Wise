@{
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}
<aside class="v2-rail workspace-sidebar" id="workspace-navigation" aria-label="Customer navigation">
    <nav class="workspace-nav-group" aria-label="My account">
        <div class="workspace-nav-heading">MY ACCOUNT</div>
        <a asp-area="CustomerPortal" asp-page="/Index" class="@(page == "/Index" ? "active" : null)" aria-current="@(page == "/Index" ? "page" : null)">
            <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i><span>My dashboard</span>
        </a>
        <a asp-area="CustomerPortal" asp-page="/Index" asp-fragment="my-requests">
            <i class="fa-solid fa-file-lines" aria-hidden="true"></i><span>My requests</span>
        </a>
        <a asp-area="CustomerPortal" asp-page="/Index" asp-fragment="my-quotations">
            <i class="fa-solid fa-file-invoice-dollar" aria-hidden="true"></i><span>My quotations</span>
        </a>
    </nav>
</aside>
<button type="button" class="workspace-nav-backdrop" tabindex="-1" aria-label="Close navigation"></button>
