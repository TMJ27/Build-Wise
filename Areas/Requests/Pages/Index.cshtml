@page
@model BuildWise.Web.Areas.Requests.Pages.IndexModel
@using BuildWise.Lib.Enums.Statuses
@using BuildWise.Web.Services.Requests
@{
    ViewData["Title"] = "Requests";
    ViewData["PageTitle"] = ViewData["Title"];
    ViewData["PageSubTitle"] = "Capture customer requests, prepare their scope and create quotations.";
    var cards = new (ClientRequestStatus? Status, string Title, string Icon)[]
    {
        (null, "Total requests", "fa-file-lines"),
        (ClientRequestStatus.Open, "Open requests", "fa-folder-open"),
        (ClientRequestStatus.Pending_Verification, "Pending verification", "fa-clock"),
        (ClientRequestStatus.Quoted, "Quoted requests", "fa-file-invoice-dollar")
    };
}

@section actionbar {
    <a class="btn primary" asp-page="Create"><i class="fa-solid fa-plus" aria-hidden="true"></i><span>New request</span></a>
}

<div class="requests-page">
    <div class="request-summary" aria-label="Request summary">
        @foreach (var card in cards)
        {
            <a asp-page="Index" asp-route-status="@card.Status" class="request-summary-card @(Model.Status == card.Status ? "selected" : null)">
                <span class="summary-icon"><i class="fa-solid @card.Icon" aria-hidden="true"></i></span>
                <span><span class="summary-label">@card.Title</span><strong>@Model.Count(card.Status).ToString("D2")</strong></span>
            </a>
        }
    </div>
    <section class="panel requests-panel">
        <div class="requests-panel-heading"><div><h2>Request register</h2><p>Customer requests and their current status.</p></div><span class="badge">@Model.TotalCount requests</span></div>
        <nav class="request-tabs" aria-label="Request status">
            <a asp-page="Index" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" class="@(!Model.Status.HasValue ? "active" : null)">All requests <span>@Model.TotalCount</span></a>
            @foreach (var status in Enum.GetValues<ClientRequestStatus>())
            {
                <a asp-page="Index" asp-route-status="@status" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" class="@(Model.Status == status ? "active" : null)">@RequestDisplay.StatusName((int)status) <span>@Model.Count(status)</span></a>
            }
        </nav>
        <form method="get" class="form-filters" role="search">
            <input type="hidden" asp-for="Status" />
            <label class="form-search">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <span class="sr-only">Search requests</span>
                <input class="form-control" asp-for="Search" type="search" maxlength="120" placeholder="Search request, customer, reference or site..." />
            </label>
            <label class="form-filter"><span>Sort by</span><select class="form-control" asp-for="Sort"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="customer">Customer name</option></select></label>
            <button class="btn" type="submit">Apply filters</button>
            @if (Model.Search.Length > 0 || Model.Status.HasValue || Model.Sort != "newest")
            {
                <a class="request-clear" asp-page="Index">Clear filters</a>
            }
        </form>
        <div class="table-wrap">
            <table class="configuration-table">
                <caption class="sr-only">Customer requests matching the selected filters</caption>
                <thead><tr><th scope="col">Reference</th><th scope="col">Title</th><th scope="col">Customer</th><th scope="col">Status</th><th scope="col">Scope items</th><th scope="col">Creation date</th></tr></thead>
                <tbody>
                    @foreach (var request in Model.Records)
                    {
                        <tr>
                            <td><a class="record-link record-id" asp-page="Details" asp-route-id="@request.Id">@(request.ReferenceNumber ?? request.Id.ToString()) <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a></td>
                            <td>@request.Title</td><td>@request.CustomerName</td>
                            <td><span class="badge">@RequestDisplay.StatusName(request.StatusId)</span></td>
                            <td>@request.ScopeItemCount</td><td>@request.CreationDate.ToString("dd MMM yyyy, HH:mm")</td>
                        </tr>
                    }
                    @if (Model.Records.Count == 0)
                    {
                        <tr><td colspan="6">@(Model.TotalCount == 0 ? "No requests have been added." : "No requests match the selected filters.")</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="requests-table-footer">
            <span>@Model.Records.Count of @Model.FilteredCount requests shown</span>
            @if (Model.PageCount > 1)
            {
                <nav class="request-pagination" aria-label="Request pages">
                    @if (Model.PageNumber > 1)
                    {
                        <a class="btn" asp-page="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-status="@Model.Status" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort">Previous</a>
                    }
                    <span>Page @Model.PageNumber of @Model.PageCount</span>
                    @if (Model.PageNumber < Model.PageCount)
                    {
                        <a class="btn" asp-page="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-status="@Model.Status" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort">Next</a>
                    }
                </nav>
            }
        </div>
    </section>
</div>
